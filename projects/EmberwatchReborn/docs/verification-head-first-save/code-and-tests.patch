+  assert.deepEqual(storage.writes, []);
+});
+
+test('every load rereads both slots and same-revision changed payloads are fully validated', () => {
+  const storage = memory(base), store = createStore(storage), original = store.load();
+  rewrite(storage.data, 0, e => payloadChange(e, s => { s.options.flashes = 0; }));
