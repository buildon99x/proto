+  const changed = store.load(); assert.equal(changed.revision, original.revision); assert.equal(changed.state.options.flashes, 0);
+  rewrite(storage.data, 0, e => payloadChange(e, s => { s.gold++; }));
+  storage.data.set(keys.head, JSON.stringify({...JSON.parse(storage.data.get(keys.head)), ...receipt(storage.data, 0)}));
+  const rejected = store.load(); assert.equal(rejected.revision, 2); assert.equal(rejected.recovered, true);
