;font:10px system-ui;color:white;text-shadow:0 1px 2px #000}.minor{color:#a8b9be;font-size:12px;line-height:1.6}.gold{color:#eac882}#objective{position:absolute;right:24px;top:84px;text-align:right;max-width:300px;font-size:13px;line-height:1.8;text-shadow:0 2px 3px #000}#objective strong{color:#e8c087;font-size:15px}#boss{position:absolute;top:68px;width:310px;left:calc(50% - 155px);text-align:center;color:#f3bca9}#hint{position:absolute;bottom:104px;left:20%;right:20%;text-align:center;color:#f4e0b4;text-shadow:0 2px 4px black;font-size:14px}#toast{position:absolute;top:32%;left:25%;right:25%;text-align:center;color:#ffe4ac;background:#15192cde;border-radius:5px;padding:12px;opacity:0;transition:opacity .15s}#toast.visible{opacity:1}#hotbar{position:absolute;bottom:22px;left:50%;transform:translateX(-50%);display:flex;gap:8px;align-items:end}#hotbar button{position:relative;min-width:89px;min-height:59px;border-color:#78837d;background:#172032ee;font-size:12px;padding:7px}#hotbar button b{display:block;color:#c7ac78;font-size:10px;margin-bottom:6px}#hotbar button em{font:11px system-ui;color:#86c6dc;display:block;margin-top:4px}#hotbar button.active{box-shadow:0 0 14px #8abeb888;border-color:#c2eee1}.overlay{position:fixed;inset:0;display:flex;justify-content:center;align-items:center;background:#0c1224a8;padding:22px;backdrop-filter:blur(4px);z-index:5}.overlay[hidden]{display:none}.panel{width:min(740px,95vw);max-height:91vh;overflow:auto;border:1px solid #a28b63;border-radius:9px;background:linear-gradient(130deg,#242c3e,#141c2d 65%);padding:30px;box-shadow:0 16px 70px #000a}.panel.wide{width:min(950px,96vw)}.eyebrow{font:11px system-ui;letter-spacing:4px;color:#8acbc5}.panel h1{font:46px Georgia,serif;letter-spacing:2px;margin:16px 0 7px;color:#f2dbb0}.panel h2{margin:0 0 16px;color:#edd2a6;font-size:24px}.panel h3{color:#d3bc91}.panel p{line-height:1.8;color:#c6d0d4}.panel .lede{font-size:17px;color:#e6c897}.row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:12px 0}.buttons{display:flex;flex-wrap:wrap;gap:9px;margin-top:20px}.divider{border-top:1px solid #75818a44;margin:20px 0}.skills{display:grid;grid-template-columns:1fr 1fr;gap:10px}.skill{border:1px solid #59656b;border-radius:5px;background:#121b2a99;padding:12px}.skill p{margin:7px 0;font-size:12px}.skill .row{margin:0;font-size:14px}.skill .effect{font:12px system-ui;color:#99d2d0;line-height:1.6;white-space:pre-line}.warning{color:#e6b18e!important}.controls{display:grid;grid-template-columns:1fr 1fr;gap:8px;color:#afc1c7;font-size:13px}.pill{display:inline-block;border:1px solid #52736f;color:#a6d4ca;border-radius:20px;padding:4px 10px;font-size:11px;margin-bottom:10px}#touch{display:none}\n@media(pointer:coarse){#touch{display:flex;position:absolute;bottom:92px;left:14px;right:14px;justify-content:space-between;align-items:end;pointer-events:none}#touch button{pointer-events:auto;background:#193543a8;touch-action:none}.pad{display:grid;grid-template-columns:42px 42px 42px;gap:4px}.pad button:first-child{grid-column:2}.pad button:nth-child(2){grid-column:1}.pad button{width:42px;height:42px;padding:0}#hotbar button{min-width:61px;font-size:10px}#hotbar{gap:4px;bottom:12px}#hint{bottom:196px;font-size:12px}}\n@media(max-width:700px){.brand{font-size:13px}header{padding:10px}#vitals{left:10px;top:64px;width:175px;padding:8px}#objective{right:10px;top:70px;max-width:160px;font-size:10px}#objective strong{font-size:12px}#boss{top:200px;width:230px;left:calc(50% - 115px)}.panel{padding:20px}.panel h1{font-size:34px}.skills{grid-template-columns:1fr}#toast{left:10%;right:10%}.controls{grid-template-columns:1fr}}\n.binding-list{display:grid;gap:8px}.binding-row{display:flex;gap:12px;justify-content:space-between;align-items:center;border-bottom:1px solid #65717744;padding:7px 0}.binding-row>div{display:flex;flex-wrap:wrap;gap:4px;justify-content:flex-end}.binding-row strong{min-width:100px;font-size:13px}#hotbar button{max-width:180px}#hotbar button b{max-width:150px}\n@media(max-width:700px){.binding-row{display:block}.binding-row>div{justify-content:flex-start;margin-top:7px}#hotbar button b{max-width:80px;font-size:9px}}\n@media(max-width:520px){#hotbar{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));width:calc(100vw - 24px);gap:4px;bottom:10px}#hotbar button{min-width:0;min-height:54px;padding:4px;font-size:10px}#hotbar button[hidden]{display:none}#hotbar button b{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#hint{bottom:143px;left:10px;right:10px}#touch{bottom:158px}#objective{font-size:11px;max-width:42vw;right:12px}#vitals{left:12px;width:46vw}}\n\n#hotbar button.resource-low,#hotbar button.status-blocked{border-color:#b46b73}#hotbar button.resource-low em,#hotbar button.status-blocked em{color:#f29aaa}\n\n#objective .objective-detail{margin-top:7px;background:#172032e8;pointer-events:auto;font-size:12px;min-height:34px}\n\n@media(max-width:380px){#hotbar{grid-template-columns:repeat(3,minmax(0,1fr))}#hint{bottom:205px}#touch{bottom:225px}}\n\n@media(min-width:521px) and (max-width:900px){#hotbar{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));width:calc(100vw - 32px);gap:4px;bottom:10px}#hotbar button{min-width:0;min-height:54px;padding:4px}#hotbar button[hidden]{display:none}#hint{bottom:143px}#touch{bottom:158px}}\n\n/* Immediate low-noise accepted-input feedback; remains legible at flash=0. */\n[data-combat].input-pressed{outline:2px solid #f3d394;outline-offset:2px}\n[data-combat].input-wait{outline:2px dashed #f3d394;outline-offset:2px}\n\n#hotbar{max-width:calc(100vw - 24px);flex-wrap:wrap;justify-content:center;width:max-content}\n@media(max-width:750px){#hotbar{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));width:calc(100vw - 24px);gap:4px;bottom:8px}#hotbar button{min-width:0;max-width:none;font-size:10px;padding:5px}#hotbar button b{font-size:9px;overflow-wrap:anywhere}#hotbar button em{font-size:9px}#hint{bottom:152px;left:12px;right:12px}#touch{bottom:156px}.binding-row{flex-wrap:wrap}.binding-row>div{justify-content:flex-start}.row select{max-width:62%}}\n\n/* R14a7: first-combat capture showed centre notices masking the fight.\n   Keep status semantics/lifetime; narrow/coarse layouts need separate screen QA. */\n@media(min-width:901px) and (min-height:600px) and (pointer:fine){\n #toast{top:auto;bottom:132px;left:50%;right:auto;transform:translateX(-50%);width:max-content;max-width:calc(100vw - 48px);padding:8px 12px;font-size:13px;line-height:1.5;pointer-events:none}\n}\n",
    expected: /grid-template-columns:repeat\(var\(--hotbar-columns,6\),minmax\(0,1fr\)\)/,
    operator: 'match',
    diff: 'simple'
  }
