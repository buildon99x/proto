{
  "name": "smash-rally-3d",
  "version": "0.1.0",
  "private": true,
  "description": "A PlayCanvas TypeScript project",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "fmt": "prettier --check .",
    "fmt:fix": "prettier --write .",
    "lint": "tsc --noEmit",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "playcanvas": "2.23.2"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.23.2"
  }
}
