{
  "name": "diorama-gallery",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node build.mjs && python3 -m http.server 4173 --directory dist",
    "build": "node setup.mjs && node build.mjs",
    "test": "node setup.mjs && node --test test/*.test.mjs",
    "lint": "node --check src/main.js && node --check src/session.js",
    "test:browser": "node test/browser.mjs",
    "test:clean": "node test/clean-build.mjs"
  }
}
